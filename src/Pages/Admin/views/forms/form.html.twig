<title>{% block title %}Espace Administrateur - Ajout de Données{% endblock %}</title>
{% block body %}
	<div class="align">
		<button class="add">
			<a class="clean-text" href="/admin/add">Ajouter</a>
		</button>
		<button class="modify">
			<a class="clean-text" href="/admin/modify/list">Modifier</a>
		</button>
		<button class="delete">
			<a class="clean-text" href="/admin/modify/list">Supprimer</a>
		</button>
	</div>

	<h1 class="align">{{ is_edit ? 'Modifier un post' : 'Ajouter un post' }}</h1>

	<div class="form-container align">
		{{ form_start(form, {
        	'attr': {
            	'enctype': 'multipart/form-data',
            	'id': 'dynamic-form'
        	}
    	}) }}

		{% if form.page is defined %}
        	{{ form_row(form.page) }}
    	{% endif %}

		<div id="dynamic-fields">
    		{% if form.membre is defined %}
        		{% include '@admin/forms/membersform.html.twig' with {'form': form.membre} %}
    		{% else %}
        		{% include '@admin/forms/regularform.html.twig' with {'form': form} %}
    		{% endif %}
		</div>

		<button type="submit">{{ is_edit ? 'Modifier' : 'Ajouter' }}</button>

		{{ form_end(form) }}
	</div>

	<script>
		document.addEventListener('DOMContentLoaded', function() {
			const pageSelect = document.querySelector('#posts_page');
			const dynamicFields = document.getElementById('dynamic-fields');
			const entityType = {{ entityType|json_encode|raw }};
			const entityId = {{ entityId|json_encode|raw }};

			if (pageSelect) {
				pageSelect.addEventListener('change', function() {
					updateFormFields(this.value);
				});

				if (pageSelect.value) {
					updateFormFields(pageSelect.value);
				}
			}

			function updateFormFields(page) {
				if (!page) {
					dynamicFields.innerHTML = '<p class="loading">Sélectionnez une page pour charger le formulaire approprié</p>';
					return;
				}

				dynamicFields.innerHTML = '<p class="loading">Chargement...</p>';

				fetch(`/form/data?page=${encodeURIComponent(page)}&type=${entityType}&id=${entityId}`)
					.then(response => {
						if (!response.ok) {
							throw new Error('Network response was not ok');
						}
						return response.json();
					})
					.then(data => {
						if (data.html && data.html.trim() !== '') {
							dynamicFields.innerHTML = data.html;
							setupRoleBranchLogic();
						} else {
							if (page === 'membres') {
								dynamicFields.innerHTML = `
									<div class="form-row">
										<label for="membre_grade">Grade</label>
										<select id="membre_grade" name="membre[grade]">
											<option value="">Choisir un grade</option>
											<option value="admin">Administrateur</option>
											<option value="member">Salarié</option>
											<option value="benevol">Bénévole</option>
										</select>
									</div>
									<div class="form-row">
										<label for="membre_branch">Branche d'activité</label>
										<select id="membre_branch" name="membre[branch]">
											<option value="">Choisir une branche</option>
											<option value="mb">Membre du Bureau</option>
											<option value="ca">Autre Membre du CA</option>
											<option value="pp">Pôle Pilotage</option>
											<option value="pla">Pôle Logistique et Administratif</option>
											<option value="paio">Pôle Accompagnement, Information et Orientation des Habitants</option>
											<option value="pph">Pôle Projets d'Habitants</option>
											<option value="pase">Pôle Actions Socioéducatives Enfance</option>
											<option value="pasj">Pôle Actions Socioéducatives Jeunesse</option>
											<option value="pfpa">Pôle Familes, Parentalité et Animation Vie Sociale Locale</option>
											<option value="alc">Atelier Loisirs Créatifs</option>
											<option value="ar">Atelier Radio</option>
											<option value="acb">Atelier Cyber Base</option>
										</select>
									</div>
									<div class="form-row">
										<label for="membre_name">Nom</label>
										<input type="text" id="membre_name" name="membre[name]" required>
									</div>
									<div class="form-row">
										<label for="membre_job">Fonction</label>
										<input type="text" id="membre_job" name="membre[job]" required>
									</div>
								`;
							} else {
								dynamicFields.innerHTML = `
									<div class="form-row">
										<label for="posts_name">Titre</label>
										<input type="text" id="posts_name" name="posts[name]" required>
									</div>
									<div class="form-row">
										<label for="posts_description">Description</label>
										<textarea id="posts_description" name="posts[description]" rows="4" required></textarea>
									</div>
									<div class="form-row">
										<label for="posts_image">Image</label>
										<input type="file" id="posts_image" name="posts[image]">
									</div>
								`;
							}
						}
					})
					.catch(error => {
						console.error('Fetch error:', error);
						if (page === 'membres') {
							dynamicFields.innerHTML = `
								<div class="form-row">
										<label for="membre_grade">Grade</label>
										<select id="membre_grade" name="membre[grade]">
											<option value="">Choisir un grade</option>
											<option value="admin">Administrateur</option>
											<option value="member">Salarié</option>
											<option value="benevol">Bénévole</option>
										</select>
									</div>
									<div class="form-row">
										<label for="membre_branch">Branche d'activité</label>
										<select id="membre_branch" name="membre[branch]">
											<option value="">Choisir une branche</option>
											<option value="mb">Membre du Bureau</option>
											<option value="ca">Autre Membre du CA</option>
											<option value="pp">Pôle Pilotage</option>
											<option value="pla">Pôle Logistique et Administratif</option>
											<option value="paio">Pôle Accompagnement, Information et Orientation des Habitants</option>
											<option value="pph">Pôle Projets d'Habitants</option>
											<option value="pase">Pôle Actions Socioéducatives Enfance</option>
											<option value="pasj">Pôle Actions Socioéducatives Jeunesse</option>
											<option value="pfpa">Pôle Familes, Parentalité et Animation Vie Sociale Locale</option>
											<option value="alc">Atelier Loisirs Créatifs</option>
											<option value="ar">Atelier Radio</option>
											<option value="acb">Atelier Cyber Base</option>
										</select>
									</div>
									<div class="form-row">
										<label for="membre_name">Nom</label>
										<input type="text" id="membre_name" name="membre[name]" required>
									</div>
									<div class="form-row">
										<label for="membre_job">Fonction</label>
										<input type="text" id="membre_job" name="membre[job]" required>
									</div>
							`;
						} else {
							dynamicFields.innerHTML = `
								<div class="form-row">
									<label for="posts_name">Titre</label>
									<input type="text" id="posts_name" name="posts[name]" required>
								</div>
								<div class="form-row">
									<label for="posts_description">Description</label>
									<textarea id="posts_description" name="posts[description]" rows="4" required></textarea>
								</div>
								<div class="form-row">
									<label for="posts_image">Image</label>
									<input type="file" id="posts_image" name="posts[image]">
								</div>
							`;
						}
					});
			}

			function setupRoleBranchLogic() {
				const branchField = document.querySelector('[name$="[membre][branch]"]');
				if (!branchField) return;

				const roleMap = JSON.parse(branchField.dataset.roleMap || '{}');
				const allOptions = Array.from(branchField.options).filter(opt => opt.value);

				document.querySelector('[name$="[membre][grade]"]')?.addEventListener('change', function() {
					const selectedRole = this.value;
					const allowedBranches = roleMap[selectedRole] || [];

					branchField.innerHTML = '';
					const placeholder = document.createElement('option');
					placeholder.value = '';
					placeholder.textContent = "Choisir une branche d'activité";
					branchField.appendChild(placeholder);

					allOptions.forEach(option => {
						if (allowedBranches.includes(option.value)) {
							branchField.appendChild(option.cloneNode(true));
						}
					});
				});
			}
		});
	</script>
	{% block importmap %}
		{{ importmap('app') }}
	{% endblock %}
{% endblock %}